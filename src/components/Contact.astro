---
import { profile } from '../content/profile';
import Prompt from './Prompt.astro';
---
<section id="contact">
  <div class="container inner">
    <Prompt cmd="$ ./contact --now" />
    <h2>Let&rsquo;s build something.</h2>
    <p class="lead">{profile.languages} · {profile.replyTime}</p>
    <div class="links">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <a href={profile.links.github}>{profile.links.githubLabel}</a>
      <a href={profile.links.linkedin}>LinkedIn</a>
    </div>
  </div>
</section>
<style>
  section { border-top: 1px solid var(--border); }
  .inner { padding-block: var(--s-9); }
  h2 { margin: var(--s-3) 0 0; font-size: var(--fs-contact); letter-spacing: -0.02em; color: var(--text-strong); }
  .lead { margin: 20px 0 0; font-size: var(--fs-contact-lead); color: var(--text-muted); }
  .links { margin-top: 36px; display: flex; flex-wrap: wrap; gap: var(--s-5); font-family: var(--font-mono); font-size: var(--fs-body-lg); }
</style>
